generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CUSTOMER
}
enum SaleUnit {
  KG
  GRAM
  PIECE
  PACK
}
enum MediaType {
  IMAGE
  VIDEO
}
enum OrderStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}
enum PaymentMethod {
  BANK_TRANSFER
  BTCPAY
  ZARINPAL
  CASH_ON_DELIVERY
}
enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}
enum DiscountType {
  PERCENT
  FIXED
}

model User {
  id                 String   @id @default(cuid())
  name               String
  mobile             String?  @unique @db.VarChar(16)
  email              String?  @unique
  passwordHash       String?
  role               UserRole @default(CUSTOMER)
  active             Boolean  @default(true)
  // Store only encrypted TOTP secrets; JWT credentials auth is configured in phase 4.
  twoFactorSecretEnc String?
  twoFactorEnabled   Boolean  @default(false)
  sessionVersion     Int      @default(0)
  emailVerifiedAt    DateTime? @db.Timestamptz(3)
  addresses          CustomerAddress[]
  adminOwner         Boolean @default(false)
  adminPermissions   String[] @default([])
  mustChangePassword Boolean @default(false)
  mobileVerifiedAt   DateTime? @db.Timestamptz(3)
  marketingSms       Boolean @default(false)
  consentEvents      MarketingConsentEvent[]
  orders             Order[]
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  nameFa      String
  nameEn      String
  descriptionFa String?
  descriptionEn String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
}

model Product {
  id                  String    @id @default(cuid())
  slug                String    @unique
  nameFa              String
  nameEn              String
  descriptionFa       String    @db.Text
  descriptionEn       String    @db.Text
  categoryId          String
  category            Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // All money is integer Toman. Price is per priceBasisQuantity units.
  priceToman          Int
  unit                SaleUnit
  priceBasisQuantity  Decimal   @default(1) @db.Decimal(12, 3)
  minOrderQuantity    Decimal   @default(1) @db.Decimal(12, 3)
  orderStepQuantity   Decimal   @default(1) @db.Decimal(12, 3)
  // Null means no limit. Capacity reservations are transactional in phase 3.
  stockQuantity       Decimal?  @db.Decimal(12, 3)
  dailyCapacity       Decimal?  @db.Decimal(12, 3)
  preparationMinutes  Int
  featured            Boolean   @default(false)
  active              Boolean   @default(true)
  media               ProductMedia[]
  dailyUsage          ProductDailyUsage[]
  orderItems          OrderItem[]
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
  @@index([active, categoryId])
  @@index([featured, active])
}

model ProductMedia {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type            MediaType
  cloudinaryId    String    @unique
  secureUrl       String
  altFa           String
  altEn           String
  width           Int
  height          Int
  bytes           Int
  durationSeconds Decimal?  @db.Decimal(8, 3)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  @@index([productId, sortOrder])
}

model DeliveryZone {
  id              String   @id @default(cuid())
  cityFa          String
  cityEn          String
  nameFa          String
  nameEn          String
  feeToman        Int
  deliveryMinutes Int
  active          Boolean  @default(true)
  orders          Order[]
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  @@unique([cityFa, nameFa])
}

model DiscountCode {
  id                  String       @id @default(cuid())
  code                String       @unique
  type                DiscountType
  value               Int
  minSubtotalToman    Int          @default(0)
  maxDiscountToman    Int?
  usageLimit          Int?
  usedCount           Int          @default(0)
  showInCustomerClub  Boolean      @default(false)
  startsAt            DateTime?    @db.Timestamptz(3)
  expiresAt           DateTime?    @db.Timestamptz(3)
  active              Boolean      @default(true)
  orders              Order[]
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
}

model Order {
  id                         String         @id @default(cuid())
  // Generate cryptographically random tracking codes in checkout; never expose sequential IDs.
  invoiceNumber              String?        @unique
  paymentReference           String?        @unique
  paymentConfirmedAt         DateTime?      @db.Timestamptz(3)
  transferReference          String?        @unique
  bankTransferSnapshot       Json?
  trackingCode               String         @unique @db.VarChar(32)
  idempotencyKey             String         @unique @db.VarChar(64)
  requestFingerprint         String         @db.VarChar(64)
  locale                     String         @db.VarChar(2)
  capacityDay                String         @db.VarChar(10)
  inventoryReserved          Boolean        @default(true)
  reservationExpiresAt       DateTime?      @db.Timestamptz(3)
  reservationExpiredAt       DateTime?      @db.Timestamptz(3)
  refundRequired             Boolean        @default(false)
  userId                     String?
  user                       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName               String
  mobile                     String         @db.VarChar(16)
  address                    String         @db.Text
  city                       String
  deliveryNotes              String?        @db.Text
  deliveryZoneId             String
  deliveryZone               DeliveryZone   @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  deliveryZoneNameSnapshot    String
  status                     OrderStatus    @default(PENDING)
  paymentMethod              PaymentMethod
  paymentStatus              PaymentStatus  @default(UNPAID)
  subtotalToman              Int
  discountToman              Int            @default(0)
  shippingSnapshot           Json?
  courierDispatch            CourierDispatch?
  deliveryFeeToman           Int
  totalToman                 Int
  discountCodeId             String?
  discountCode               DiscountCode?  @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  discountCodeSnapshot       String?
  longestPreparationMinutes  Int
  zoneDeliveryMinutes        Int
  estimatedDeliveryAt        DateTime       @db.Timestamptz(3)
  items                      OrderItem[]
  statusHistory              OrderStatusHistory[]
  buyerEmail                 String? @db.VarChar(254)
  cryptoPayment              CryptoPayment?
  paymentAttempts            PaymentAttempt[]
  createdAt                  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime       @updatedAt @db.Timestamptz(3)
  @@index([status, createdAt])
  @@index([mobile, createdAt])
  @@index([userId, createdAt])
  @@index([status, reservationExpiresAt])
}

// Persist intent before calling the courier. Unknown outcomes must be reconciled, never retried.
model CourierDispatch {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
  requestState String @default("REQUESTING")
  environment String
  externalId String? @unique
  externalStatus String?
  requestSnapshot Json
  quotedFeeToman Int
  actualFeeToman Int?
  readyAt DateTime @default(now()) @db.Timestamptz(3)
  requestedBy String
  lastSyncedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model OrderItem {
  id                    String    @id @default(cuid())
  orderId               String
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Soft-delete products; snapshots also survive exceptional hard deletion.
  productId             String?
  product               Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameFa          String
  productNameEn          String
  unit                  SaleUnit
  quantity              Decimal   @db.Decimal(12, 3)
  priceBasisQuantity    Decimal   @db.Decimal(12, 3)
  unitPriceToman         Int
  lineTotalToman         Int
  preparationMinutes    Int
  stockReserved         Boolean   @default(false)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  @@index([orderId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  @@index([orderId, createdAt])
}

model PaymentAttempt {
  id             String        @id @default(cuid())
  orderId        String        @unique
  callbackNonce  String
  merchantId     String
  sandbox        Boolean
  requestState   String        @default("NEW")
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  authority      String?       @unique
  referenceId    String?       @unique
  amountToman    Int
  status         PaymentStatus @default(PENDING)
  verifiedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  @@index([orderId, createdAt])
}

model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

// Shared across VPS processes / Vercel instances, unlike in-memory rate limits.
model RateLimitBucket {
  key           String   @id
  count         Int      @default(0)
  expiresAt     DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  mobile    String   @db.VarChar(16)
  message   String   @db.Text
  locale    String   @db.VarChar(2)
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([createdAt])
}

// Capacity is reserved for the Tehran calendar day on which the order is accepted.
model ProductDailyUsage {
  productId String
  day String @db.VarChar(10)
  quantity Decimal @default(0) @db.Decimal(12, 3)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([productId, day])
}

// Signed Cloudinary uploads are allocated by an authenticated admin.
model MediaUpload {
 id String @id @default(cuid())
 publicId String @unique
 type MediaType
 adminId String
 consumed Boolean @default(false)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model AdminAudit {
 id String @id @default(cuid())
 adminId String
 action String
 targetId String
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([createdAt])
}

// One-time, purpose-specific customer login. No raw OTP is persisted.
model CustomerLoginChallenge {
 id String @id @db.Uuid
 mobile String @db.VarChar(16)
 name String @db.VarChar(100)
 verifier String @db.VarChar(64)
 marketingSms Boolean @default(false)
 ready Boolean @default(false)
 attempts Int @default(0)
 expiresAt DateTime @db.Timestamptz(3)
 consumedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([mobile, createdAt])
 @@index([expiresAt])
}
model MarketingConsentEvent {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 allowed Boolean
 policyVersion String @db.VarChar(32)
 source String @db.VarChar(32)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([userId, createdAt])
}

// Plain-text, scheduled announcements shown inside signed-in customer accounts.
model ClubAnnouncement {
 id String @id @default(cuid())
 titleFa String @db.VarChar(150)
 titleEn String @db.VarChar(150)
 bodyFa String @db.Text
 bodyEn String @db.Text
 startsAt DateTime? @db.Timestamptz(3)
 expiresAt DateTime? @db.Timestamptz(3)
 active Boolean @default(false)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([active, createdAt])
}

// One invoice per order; never silently retry an uncertain creation request.
model CryptoPayment {
 id String @id @default(cuid())
 orderId String @unique
 order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
 invoiceId String? @unique
 amountUsdCents Int
 tomanPerUsd Int
 rateExpiresAt DateTime @db.Timestamptz(3)
 storeId String
 gatewayOrigin String
 requestState String @default("NEW")
 invoiceStatus String?
 additionalStatus String?
 checkoutUrl String?
 verifiedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model CheckoutMobileChallenge {
 id String @id @db.Uuid
 mobile String @db.VarChar(16)
 verifier String @db.VarChar(64)
 ready Boolean @default(false)
 attempts Int @default(0)
 expiresAt DateTime @db.Timestamptz(3)
 verifiedAt DateTime? @db.Timestamptz(3)
 proofHash String? @db.VarChar(64)
 proofExpiresAt DateTime? @db.Timestamptz(3)
 consumedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([mobile, createdAt])
 @@index([expiresAt])
}
model SmsTestBudget {
 id String @id
 used Int @default(0)
}


model CustomerRegistration {
 id String @id @db.Uuid
 name String @db.VarChar(100)
 mobile String @db.VarChar(16)
 email String @db.VarChar(254)
 passwordHash String
 marketingSms Boolean @default(false)
 mobileVerifier String @db.VarChar(64)
 mobileReady Boolean @default(false)
 mobileAttempts Int @default(0)
 mobileVerifiedAt DateTime? @db.Timestamptz(3)
 emailVerifier String? @db.VarChar(64)
 emailReady Boolean @default(false)
 emailAttempts Int @default(0)
 emailExpiresAt DateTime? @db.Timestamptz(3)
 expiresAt DateTime @db.Timestamptz(3)
 consumedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([mobile, createdAt])
 @@index([expiresAt])
}

model CustomerAddress {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 title String @db.VarChar(50)
 recipientName String @db.VarChar(100)
 mobile String @db.VarChar(16)
 zoneId String @db.VarChar(100)
 address String @db.VarChar(1000)
 latitude Float?
 longitude Float?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([userId, createdAt])
}
