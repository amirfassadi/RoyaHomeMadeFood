{
  "name": "roya-food",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "build:sites": "node scripts/build-sites.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && node --import tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts && node --conditions=react-server --import tsx --test tests/server/*.test.ts",
    "admin:create": "prisma generate && node --import tsx scripts/create-admin.ts",
    "deploy:check": "node --import tsx scripts/preflight.ts",
    "maintenance:rate-limits": "prisma generate && node --import tsx scripts/cleanup-rate-limits.ts",
    "test:integration": "prisma generate && node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "admin:recover": "prisma generate && node --import tsx scripts/recover-admin.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "next-intl": "4.14.9",
    "next-auth": "4.24.15",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8.16.3",
    "cloudinary": "^2.8.0",
    "zod": "^4.3.6",
    "server-only": "0.0.1",
    "lucide-react": "^0.577.0",
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "^5.9.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/pg": "^8.15.6",
    "tailwindcss": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "tsx": "^4.21.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "mysql2": "3.24.5"
  }
}
