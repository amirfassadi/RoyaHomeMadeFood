# Copy to .env locally. Never commit real credentials.
DATABASE_URL="postgresql://roya:roya_local_only@localhost:5432/roya?schema=public"
DIRECT_URL="postgresql://roya:roya_local_only@localhost:5432/roya?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set to 0 to deploy without a media upload provider; 1 requires all credentials.
ROYA_MEDIA_UPLOADS_ENABLED=0
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"
# Opt-in illustrative catalog for local UI review; keep 0 for the real storefront.
ROYA_DEMO_CATALOG="0"

# Enable only after real public deployment and acceptance tests; keep 0 in previews.
ROYA_INDEXABLE="0"

# Optional customer accounts. Guest checkout ALSO requires the OTP provider and secret below.
CUSTOMER_ACCOUNTS_ENABLED="0"
CUSTOMER_OTP_SECRET=""
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""
# Registration email delivery through a verified sending domain.
RESEND_API_KEY=""
CUSTOMER_EMAIL_FROM=""
# Test-only SMS: persistent shared cap of five attempts, never reset on deployment.
ROYA_SMS_MODE="test"
ROYA_SMS_TEST_MOBILES=""

# Overseas buyer -> delivery to a recipient in Iran. Disabled until configured/tested.
ROYA_INTERNATIONAL_ENABLED="0"
# Enable ONLY behind a restricted proxy that overwrites X-Roya-Country.
ROYA_TRUST_GEO_HEADER="0"
BTCPAY_URL=""
BTCPAY_STORE_ID=""
BTCPAY_API_KEY=""
BTCPAY_WEBHOOK_SECRET=""
# Integer Toman per USD; set a short, explicit UTC expiry. No built-in market rate.
ROYA_USD_RATE_TOMAN=""
ROYA_USD_RATE_EXPIRES_AT=""

# Server-only Alopeyk credentials; sandbox quotes cannot create customer orders.
ALOPEYK_ACCESS_TOKEN=
ALOPEYK_ENVIRONMENT=sandbox

# Manual transfer destination (required to enable BANK_TRANSFER)
# Bank transfer destinations are managed in Admin Settings and stored in PostgreSQL.

# Optional future text notifications; customer delivery policy remains disabled in admin.
KAVENEGAR_SENDER=""
